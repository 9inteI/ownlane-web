---
import Prose from '../layouts/Prose.astro';
import FaqItem from '../components/FaqItem.astro';
import { faq } from '../data/faq';
import { APP } from '../data/app';

const lang = 'es' as const;

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((q) => ({
    '@type': 'Question',
    name: q.es.p,
    acceptedAnswer: { '@type': 'Answer', text: q.es.r.join(' ') },
  })),
};
---
<Prose
  lang={lang}
  pagina="soporte"
  titulo="Own Lane · Soporte"
  descripcion="Ayuda y contacto de Own Lane, la app para empezar a correr sin red social."
  h1="Soporte"
  entradilla="Una app para empezar a correr y seguir corriendo. Sin feed, sin kudos, sin nadie mirándote."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonld)} />

  <div class="tarjeta contacto">
    <p><strong>¿Necesitas ayuda?</strong> Escribe a <a href={`mailto:${APP.email}`}>{APP.email}</a>.</p>
    <p class="sutil">Contesto yo, no un formulario. Suele tardar un par de días.</p>
  </div>

  <h2>Preguntas habituales</h2>
  <div class="lista">
    {faq.map((q, i) => (
      <FaqItem pregunta={q.es.p} abierto={i === 0}>
        {q.es.r.map((parrafo) => <p>{parrafo}</p>)}
      </FaqItem>
    ))}
  </div>

  <h2>Aviso</h2>
  <div class="tarjeta">
    <p>Own Lane no sustituye a un médico ni a un fisioterapeuta. Si algo te duele, para y consúltalo. Los días de descanso del plan no son opcionales.</p>
  </div>
</Prose>

<style>
  .contacto p + p { margin-top: 8px; }
  .lista { margin-top: 4px; border-top: 0.5px solid var(--separator); }
</style>
