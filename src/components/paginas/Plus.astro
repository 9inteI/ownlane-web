---
import Base from '../../layouts/Base.astro';
import AcordeonPlus from '../AcordeonPlus.astro';
import AppStoreBadge from '../AppStoreBadge.astro';
import InkSplash from '../ink/InkSplash.astro';
import { funciones, paginaPlus } from '../../data/plus';
import { precios } from '../../data/landing';
import { ruta, type Idioma } from '../../i18n/routes';
import { APP } from '../../data/app';

interface Props { lang: Idioma; }
const { lang } = Astro.props;
const c = paginaPlus[lang];
const p = precios[lang];

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Own Lane Plus',
  applicationCategory: 'HealthApplication',
  operatingSystem: 'iOS, watchOS',
  installUrl: APP.appStoreUrl,
  offers: [
    { '@type': 'Offer', price: '49.00', priceCurrency: 'EUR', name: lang === 'es' ? 'Anual' : 'Yearly' },
    { '@type': 'Offer', price: '4.99', priceCurrency: 'EUR', name: lang === 'es' ? 'Mensual' : 'Monthly' },
  ],
};
---
<Base
  lang={lang}
  pagina="plus"
  titulo={lang === 'es' ? 'Own Lane Plus · Qué incluye y cuánto cuesta' : 'Own Lane Plus · What it includes and what it costs'}
  descripcion={c.entradilla}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonld)} />

  <section class="cabecera">
    <InkSplash variante={1} opacidad={0.07} tam="min(480px, 66vw)" estilo="top:-120px;right:-160px" />
    <div class="envoltorio">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.titulo}</h1>
      <p class="entradilla">{c.entradilla}</p>
    </div>
  </section>

  <section class="regla">
    <div class="envoltorio interior">
      <p class="frase">{c.regla}</p>
      <p class="detalle">{c.reglaDetalle}</p>
    </div>
  </section>

  <section class="lista">
    <div class="envoltorio">
      <AcordeonPlus lang={lang} />
    </div>
  </section>

  <section class="precio">
    <div class="envoltorio interior">
      <div class="revelar">
        <p class="eyebrow">{c.precioTitulo}</p>
        <div class="cifras">
          <div class="opcion">
            <div class="num">{lang === 'es' ? APP.precios.anual : APP.precios.anualEN}</div>
            <div class="periodo">{c.anual}</div>
            <div class="nota">{c.ahorro}</div>
          </div>
          <div class="opcion">
            <div class="num">{lang === 'es' ? APP.precios.mensual : APP.precios.mensualEN}</div>
            <div class="periodo">{c.mensual}</div>
          </div>
        </div>
        <p class="prueba">{c.prueba}</p>
        <p class="gestion"><a href={ruta('soporte', lang)}>{c.gestion} →</a></p>
      </div>
      <div class="gratis tarjeta revelar">
        <h2>{p.gratisTitulo}</h2>
        <ul>{p.gratis.map((l) => <li>{l}</li>)}</ul>
        <p class="remate">{p.remate}</p>
      </div>
    </div>
  </section>

  <section class="cierre">
    <div class="envoltorio centro"><AppStoreBadge lang={lang} /></div>
  </section>
</Base>

<style>
  .cabecera { position: relative; overflow: clip; padding: 60px 0 24px; }
  h1 { margin: 14px 0 16px; max-width: 16ch; }
  .entradilla { font-size: 19px; color: var(--ink-soft); max-width: 56ch; }

  .regla { margin: 40px 0 56px; background: var(--inverse-surface); color: var(--inverse-ink); padding: 44px 0; }
  .regla .interior { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 40px; align-items: center; }
  .frase { font-size: clamp(24px, 3.4vw, 34px); font-weight: 700; letter-spacing: -0.022em; line-height: 1.15; }
  .detalle { color: var(--inverse-ink-soft); }

  .rejilla { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
  .lista .tarjeta { padding: 26px; }
  .lista h2 { font-size: 19px; font-weight: 600; margin: 16px 0 10px; }
  .lista p { color: var(--ink-soft); font-size: 16px; }

  .precio { padding: 72px 0 24px; }
  .precio .interior { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 36px; align-items: start; }
  .cifras { display: flex; gap: 40px; margin-top: 14px; flex-wrap: wrap; }
  .num { font-size: clamp(38px, 5vw, 54px); font-weight: 700; letter-spacing: -0.03em; line-height: 1; font-variant-numeric: tabular-nums; }
  .periodo { margin-top: 6px; color: var(--ink-soft); }
  .nota { margin-top: 4px; font-size: 13px; color: var(--ink-soft); }
  .prueba { margin-top: 22px; color: var(--ink-soft); max-width: 40ch; }
  .gestion { margin-top: 10px; }
  .gestion a { color: var(--ink); font-weight: 600; text-decoration: none; }
  .gestion a:hover { text-decoration: underline; }

  .gratis { padding: 26px; }
  .gratis h2 { font-size: 19px; font-weight: 600; margin-bottom: 14px; }
  .gratis ul { margin: 0; padding-left: 1.2em; display: grid; gap: 8px; color: var(--ink-soft); font-size: 16px; }
  .remate { margin-top: 18px; font-weight: 600; font-size: 15px; }

  .cierre { padding: 56px 0 24px; }
  .centro { display: grid; justify-items: center; }

  @media (max-width: 820px) {
    .regla .interior { grid-template-columns: 1fr; gap: 20px; }
  }
</style>
