---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AppStoreBadge from '../AppStoreBadge.astro';
import EvidenceBadge from '../EvidenceBadge.astro';
import InkSplash from '../ink/InkSplash.astro';
import { t } from '../../i18n/ui';
import { ruta, rutaArticulo, type Idioma } from '../../i18n/routes';
import { APP } from '../../data/app';

interface Props {
  articulo: CollectionEntry<'aprende'>;
  lang: Idioma;
  alternas: { es: string; en: string };
}
const { articulo, lang, alternas } = Astro.props;
// Content Layer de Astro 5: render(entry), no entry.render().
const { Content } = await render(articulo);
const d = articulo.data;
const tr = t(lang);

// «Sigue con»: tres del mismo idioma, primero los de la misma categoria y
// despues el resto, en el orden pedagogico de la app. Es lo que reparte la
// autoridad entre las 38 paginas: sin esto cada articulo era un callejon.
const todos = await getCollection('aprende');
const otros = todos
  .filter((a) => a.data.lang === lang && a.id !== articulo.id)
  .sort((a, b) => a.data.order - b.data.order);
const relacionados = [
  ...otros.filter((a) => a.data.category === d.category),
  ...otros.filter((a) => a.data.category !== d.category),
].slice(0, 3);

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.teaser,
  inLanguage: lang,
  datePublished: d.updated.toISOString().slice(0, 10),
  dateModified: d.updated.toISOString().slice(0, 10),
  author: { '@type': 'Organization', name: APP.nombre },
  publisher: { '@type': 'Organization', name: APP.nombre },
  // Lo que hace legible por maquinas la promesa de evidencia.
  citation: d.sources.map((s) => ({
    '@type': 'ScholarlyArticle',
    name: s.title,
    author: s.authors,
    isPartOf: s.publication,
    datePublished: String(s.year),
    url: s.url,
  })),
};

const fecha = new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en-GB', {
  day: 'numeric', month: 'long', year: 'numeric',
}).format(d.updated);
---
<Base
  lang={lang}
  titulo={`${d.title} · Own Lane`}
  descripcion={d.teaser}
  alternas={alternas}
  tipo="article"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonld)} />

  <div class="marco">
    <InkSplash variante={1} opacidad={0.06} tam="min(400px, 58vw)" suave estilo="top:-80px;right:-150px" />
    <div class="envoltorio-texto">
      <p class="volver"><a href={ruta('aprende', lang)}>← {tr('nav.aprende')}</a></p>

      <header class="cabecera">
        <!-- El nivel de evidencia va ARRIBA, como en ArticleView.swift:
             saber si algo esta demostrado cambia como lees lo que viene. -->
        <EvidenceBadge nivel={d.evidence} lang={lang} />
        <h1>{d.title}</h1>
        <p class="entradilla sutil">{d.teaser}</p>
        <p class="meta sutil">{d.minutes} {tr('articulo.minutos')} · {tr('articulo.actualizado')} {fecha}</p>
      </header>

      <div class="prosa cuerpo">
        <Content />
      </div>

      <aside class="cta">
        <p>{tr('articulo.cta')}</p>
        <AppStoreBadge lang={lang} ct="blog" variante="suave" />
      </aside>

      <section class="fuentes">
        <h2>{tr('articulo.fuentes')}</h2>
        <ol>
          {d.sources.map((s) => (
            <li>
              <a href={s.url} rel="noopener nofollow" target="_blank">{s.title}</a>
              <span class="sutil"> — {s.authors}. <i>{s.publication}</i>, {s.year}.</span>
            </li>
          ))}
        </ol>
      </section>

      <section class="sigue">
        <h2>{tr('articulo.sigue')}</h2>
        <ul>
          {relacionados.map((r) => (
            <li>
              <a href={rutaArticulo(r.data.slug, lang)}>{r.data.title}</a>
              <p class="sutil">{r.data.teaser}</p>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</Base>

<style>
  .marco { position: relative; overflow: clip; padding-bottom: 24px; }
  .volver { padding-top: 40px; font-size: 14px; }
  .volver a { color: var(--ink-soft); text-decoration: none; }
  .volver a:hover { color: var(--ink); }
  .cabecera { padding: 22px 0 30px; }
  h1 { margin: 18px 0 12px; font-size: clamp(30px, 5vw, 44px); }
  .entradilla { font-size: 19px; max-width: 50ch; }
  .meta { margin-top: 12px; font-size: 13px; }
  .cuerpo { font-size: 17px; }
  .cuerpo :global(h2) { font-size: 22px; }

  .fuentes { margin-top: 56px; padding-top: 26px; border-top: 0.5px solid var(--separator); }
  .fuentes h2 { font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-soft); }
  .fuentes ol { margin: 16px 0 0; padding-left: 1.3em; display: grid; gap: 12px; font-size: 15px; }
  .fuentes a { color: var(--ink); }

  .cta { margin-top: 48px; padding: 24px 26px; border-radius: 18px; background: var(--fill-2); display: grid; gap: 16px; justify-items: start; }
  .cta p { font-size: 16px; max-width: 46ch; }

  .sigue { margin-top: 48px; padding-top: 26px; border-top: 0.5px solid var(--separator); }
  .sigue h2 { font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-soft); }
  .sigue ul { list-style: none; margin: 16px 0 0; padding: 0; display: grid; gap: 18px; }
  .sigue a { color: var(--ink); font-weight: 600; text-decoration: none; font-size: 17px; }
  .sigue a:hover { text-decoration: underline; }
  .sigue p { margin-top: 4px; font-size: 15px; max-width: 52ch; }
</style>
