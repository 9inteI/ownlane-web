---
import Base from '../../layouts/Base.astro';
import Hero from '../sections/Hero.astro';
import StatBlock from '../sections/StatBlock.astro';
import Eje from '../sections/Eje.astro';
import Tarjetas from '../sections/Tarjetas.astro';
import Privacy from '../sections/Privacy.astro';
import Watch from '../sections/Watch.astro';
import Precios from '../sections/Precios.astro';
import Cierre from '../sections/Cierre.astro';
import { ejes } from '../../data/landing';
import { APP } from '../../data/app';

import { captura } from '../../data/capturas';
import cap2 from '../../assets/capturas/appstore-2-movil.png';
import cap3 from '../../assets/capturas/appstore-3-movil.png';
import type { Idioma } from '../../i18n/routes';

interface Props { lang: Idioma; }
const { lang } = Astro.props;

const plan = captura('plan', lang);
const aprende = captura('aprende', lang);

const meta = {
  es: {
    titulo: 'Own Lane · Correr desde cero, sin feed',
    descripcion:
      'Un plan de running para principiantes que se ajusta a cómo te has sentido y se recoloca cuando fallas un día. Sin feed, sin cuenta y sin servidor.',
    altSalida: 'Detalle de una salida: mapa del recorrido, pulsaciones y ritmo por kilómetro',
    altProgreso: 'Pantalla de progreso: minutos corriendo por semana y salidas recientes',
  },
  en: {
    titulo: 'Own Lane · Run from zero, without a feed',
    descripcion:
      'A beginner running plan that adjusts to how the session felt and reschedules when you miss a day. No feed, no account and no server.',
    altSalida: 'Run detail: route map, heart rate and pace per kilometre',
    altProgreso: 'Progress screen: minutes running per week and recent runs',
  },
} as const;

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: APP.nombre,
  applicationCategory: 'HealthApplication',
  operatingSystem: 'iOS, watchOS',
  url: APP.sitio,
  installUrl: APP.appStoreUrl,
  inLanguage: ['es', 'en'],
  description: meta[lang].descripcion,
  offers: [
    { '@type': 'Offer', price: '0', priceCurrency: 'EUR', name: 'Own Lane' },
    { '@type': 'Offer', price: '49.00', priceCurrency: 'EUR', name: 'Own Lane Plus (yearly)' },
    { '@type': 'Offer', price: '4.99', priceCurrency: 'EUR', name: 'Own Lane Plus (monthly)' },
  ],
};
---
<Base
  lang={lang}
  pagina="home"
  titulo={meta[lang].titulo}
  descripcion={meta[lang].descripcion}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonld)} />

  <Hero lang={lang} />
  <StatBlock lang={lang} />

  <Eje bloque={ejes.sentido[lang]} mancha={2} />
  <Eje
    bloque={ejes.dias[lang]}
    invertido
    piezas={[
      { src: plan.claro, srcOscuro: plan.oscuro, alt: plan.alt },
      { src: aprende.claro, srcOscuro: aprende.oscuro, alt: aprende.alt },
    ]}
  />
  <Eje
    bloque={ejes.salida[lang]}
    mancha={1}
    piezas={[
      {
        src: cap3,
        alt: meta[lang].altSalida,
      },
      {
        src: cap2,
        alt: meta[lang].altProgreso,
      },
    ]}
  />

  <Tarjetas lang={lang} />
  <Privacy lang={lang} />
  <Watch lang={lang} />
  <Precios lang={lang} />
  <Cierre lang={lang} />
</Base>
