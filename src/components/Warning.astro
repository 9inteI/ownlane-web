/* Advertencia: lo que hay que parar a leer. */
---
<aside class="aviso">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
    <path d="M12 4.5L21 20H3z" stroke-linejoin="round" /><path d="M12 10v4" /><path d="M12 17v.5" />
  </svg>
  <div><slot /></div>
</aside>
<style>
  .aviso {
    display: flex;
    gap: 13px;
    margin: 1.6em 0;
    padding: 18px 20px;
    border-radius: 14px;
    background: var(--fill-1);
    box-shadow: inset 0 0 0 1px var(--line-1);
    font-size: 16px;
  }
  svg { width: 21px; height: 21px; flex: none; margin-top: 1px; color: var(--ink); }
  .aviso :global(p) { margin: 0; }
</style>
