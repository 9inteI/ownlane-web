---
/* Los tres ejes de mensaje, apilandose uno sobre otro al bajar.
 * El pin lo hace GSAP (data-apila / data-ficha); sin JS o con reduced-motion
 * quedan como tres tarjetas normales una detras de otra, que se leen igual. */
import GrupoDispositivos from '../GrupoDispositivos.astro';
import { ejes } from '../../data/landing';
import { captura } from '../../data/capturas';
import type { Idioma } from '../../i18n/routes';

interface Props { lang: Idioma; }
const { lang } = Astro.props;

const hoy = captura('hoy', lang);
const plan = captura('plan', lang);
const detalle = captura('detalle', lang);
const aprende = captura('aprende', lang);

const fichas = [
  { bloque: ejes.sentido[lang], piezas: [hoy] },
  { bloque: ejes.dias[lang], piezas: [plan, aprende] },
  { bloque: ejes.salida[lang], piezas: [detalle] },
];
---
<section class="pila" data-apila>
  {fichas.map(({ bloque, piezas }, i) => (
    <article class="ficha" data-ficha style={`--i:${i}`}>
      <div class="dentro">
        <div class="texto">
          <h2>{bloque.titulo}</h2>
          {bloque.cuerpo.map((p) => <p>{p}</p>)}
        </div>
        <div class="moviles">
          <GrupoDispositivos
            ancho={piezas.length > 1 ? 214 : 236}
            piezas={piezas.map((p) => ({ src: p.claro, srcOscuro: p.oscuro, alt: p.alt }))}
          />
        </div>
      </div>
    </article>
  ))}
</section>

<style>
  .pila { padding: 24px 0 40px; }
  .ficha { will-change: transform; }
  .ficha + .ficha { margin-top: 22px; }

  .dentro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.86fr);
    gap: 40px;
    align-items: center;
    width: 100%;
    max-width: var(--ancho);
    margin-inline: auto;
    padding: 40px 34px;
    border-radius: 26px;
    background: var(--card);
    border: 0.5px solid var(--card-border);
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.09);
  }
  @media (prefers-color-scheme: dark) {
    .dentro { box-shadow: 0 18px 44px rgba(0, 0, 0, 0.6); }
  }

  h2 { font-size: clamp(1.8rem, 3.2vw, 2.8rem); letter-spacing: -0.03em; max-width: 15ch; }
  .texto p { margin-top: 16px; font-size: 17px; color: var(--ink-soft); max-width: 48ch; }
  .moviles { justify-self: center; }

  @media (max-width: 900px) {
    .dentro { grid-template-columns: 1fr; gap: 30px; padding: 30px 22px; }
    .ficha + .ficha { margin-top: 16px; }
  }
</style>
