---
/* Hero asimetrico: el titular manda a ancho completo, y el grupo de
 * dispositivos flota por debajo y a la derecha, solapandolo.
 *
 * La regla de las dos lineas: el H1 va en un contenedor de 64rem a ancho
 * completo, no dentro de una columna de rejilla. Antes caia en una columna de
 * ~520 px y salian tres lineas en escritorio y cuatro en movil. */
import { Image } from 'astro:assets';
import GrupoDispositivos from '../GrupoDispositivos.astro';
import AppStoreBadge from '../AppStoreBadge.astro';
import Splatter from '../ink/Splatter.astro';
import CursorTrail from '../ink/CursorTrail.astro';
import { hero } from '../../data/landing';
import { captura } from '../../data/capturas';
import type { Idioma } from '../../i18n/routes';
import logo from '../../assets/brand/ownlane-logo.png';

interface Props { lang: Idioma; }
const { lang } = Astro.props;
const c = hero[lang];
const [linea1, linea2] = c.h1.split('\n');

const hoy = captura('hoy', lang);
const plan = captura('plan', lang);
---
<section class="hero">
  <Splatter
    variante={1}
    tam="min(720px, 88vw)"
    opacidad={0.085}
    brillo
    parallax={0.1}
    estilo="top:-220px;right:-240px"
  />
  <CursorTrail />

  <div class="envoltorio">
    <div class="titular">
      <Image class="logo" src={logo} alt="" aria-hidden="true" width={64} densities={[1, 2]} loading="eager" />
      <h1>
        <span class="linea">{linea1}</span>
        <span class="linea baja">{linea2}</span>
      </h1>
    </div>

    <div class="pie">
      <p class="entradilla">{c.entradilla}</p>
      <div class="acciones">
        <AppStoreBadge lang={lang} />
        <p class="nota sutil">{c.pie}</p>
      </div>
    </div>
  </div>

  <div class="flota">
    <GrupoDispositivos
      ancho={236}
      prioritario
      piezas={[
        { src: hoy.claro, srcOscuro: hoy.oscuro, alt: hoy.alt },
        { src: plan.claro, srcOscuro: plan.oscuro, alt: plan.alt },
      ]}
    />
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding: 40px 0 0;
    isolation: isolate;
  }

  .logo { width: 64px; height: 64px; border-radius: 17px; margin-bottom: 30px; }

  /* Aqui esta la correccion: 64rem a ancho completo, no una columna estrecha. */
  /* Metrica de las dos lineas, calculada, no a ojo:
     a 4.4rem (70 px) la linea 1 son 26 caracteres ~ 693 px y la linea 2 son
     21 caracteres ~ 600 px. Las dos caben de sobra en los 1024 px del
     contenedor, asi que el H1 son DOS lineas y no tres. */
  .titular { max-width: 64rem; }
  h1 {
    font-size: clamp(2.6rem, 4.6vw, 4.4rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
  }
  .linea { display: block; }
  .baja { color: var(--ink-soft-lg); }


  /* Una sola columna: en dos, la entradilla se queda en 380 px y sale un
     parrafo de cuatro lineas, que es justo lo que no queremos. */
  .pie {
    display: grid;
    gap: 30px;
    justify-items: start;
    margin-top: 40px;
    max-width: 44rem;
  }
  .entradilla { font-size: clamp(17px, 1.5vw, 20px); color: var(--ink-soft); max-width: 46ch; }
  .acciones { display: grid; justify-items: start; gap: 12px; }
  .nota { font-size: 13px; }

  /* El grupo de moviles flota a la derecha y solapa el titular por abajo.
     Va absoluto y el texto se limita a la mitad izquierda: si se deja en flujo
     con margen negativo, se come el boton de descarga. */
  .flota { pointer-events: none; }
  .flota > :global(*) { pointer-events: auto; }

  @media (min-width: 981px) {
    /* Medido, no a ojo: la linea 2 del H1 acaba en x=947 y su caja baja hasta
       y=342. Con el grupo a 236 px de ancho (347 el conjunto) y el hero a 760,
       el grupo baja a y 363, por debajo del titular, que acaba en 342. */
    .hero { padding-bottom: 48px; min-height: 800px; }
    .titular { max-width: 64rem; }
    .pie { max-width: 40rem; }
    /* Anclado abajo a la derecha: solapa el hueco que deja el texto, no el
       titular ni el boton. Anclarlo por arriba lo hacia depender del alto del
       H1 y acababa pisandolo. */
    .flota {
      position: absolute;
      bottom: 0;
      right: max(20px, calc(50% - var(--ancho) / 2));
      z-index: -1;
    }
  }

  @media (max-width: 980px) {
    .pie { grid-template-columns: 1fr; gap: 26px; align-items: start; }
    .flota { display: flex; justify-content: center; margin-top: 40px; }
  }

</style>
