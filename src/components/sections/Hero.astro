---
import { Image } from 'astro:assets';
import AppStoreBadge from '../AppStoreBadge.astro';
import InkSplash from '../ink/InkSplash.astro';
import { hero } from '../../data/landing';
import type { Idioma } from '../../i18n/routes';
import logo from '../../assets/brand/ownlane-logo.png';
import captura from '../../assets/capturas/appstore-1-movil.png';

interface Props { lang: Idioma; }
const { lang } = Astro.props;
const c = hero[lang];
const [linea1, linea2] = c.h1.split('\n');
---
<section class="hero">
  <InkSplash variante={1} opacidad={0.09} tam="min(620px, 78vw)" estilo="top:-160px;right:-180px" />
  <InkSplash variante={3} opacidad={0.06} tam="min(380px, 52vw)" suave estilo="bottom:-120px;left:-150px" />

  <div class="envoltorio malla">
    <div class="texto">
      <Image
        class="logo"
        src={logo}
        alt=""
        aria-hidden="true"
        width={72}
        densities={[1, 2]}
        loading="eager"
      />
      <h1>
        <span class="linea">{linea1}</span>
        <span class="linea acento">{linea2}</span>
      </h1>
      <p class="entradilla">{c.entradilla}</p>
      <div class="acciones">
        <AppStoreBadge lang={lang} />
      </div>
      <p class="pie sutil">{c.pie}</p>
    </div>

    <div class="movil">
      <Image
        src={captura}
        alt={c.captionCaptura}
        width={300}
        densities={[1, 2]}
        quality={72}
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: clip; padding: 56px 0 40px; }
  .malla {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 48px;
    align-items: center;
  }
  .logo { width: 72px; height: 72px; border-radius: 19px; margin-bottom: 26px; }
  h1 { display: flex; flex-direction: column; }
  .linea { display: block; }
  .acento { color: var(--ink-soft-lg); }
  .entradilla {
    margin-top: 22px;
    font-size: clamp(17px, 2vw, 20px);
    color: var(--ink-soft);
    max-width: 46ch;
  }
  .acciones { margin-top: 30px; }
  .pie { margin-top: 16px; font-size: 13px; }
  .movil { justify-self: center; max-width: 300px; }
  .movil :global(img) {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 22px 44px rgba(0, 0, 0, 0.17));
  }

  @media (max-width: 900px) {
    .malla { grid-template-columns: 1fr; gap: 40px; }
    .movil { max-width: 260px; }
  }
</style>
