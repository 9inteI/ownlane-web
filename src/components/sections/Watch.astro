---
/* 06 · Apple Watch.
 *
 * Los dos relojes ya no van centrados y planos: se solapan un poco, con una
 * mancha de tinta detras que hace de suelo. El texto pasa a la derecha, asi
 * que la seccion invierte la direccion de lectura de las de arriba y la pagina
 * respira en vez de repetir columna-izquierda cinco veces seguidas.
 */
import { Image } from 'astro:assets';
import Rotulo from '../Rotulo.astro';
import InkSplash from '../ink/InkSplash.astro';
import { reloj } from '../../data/landing';
import type { Idioma } from '../../i18n/routes';
import hoy from '../../assets/capturas/watch-1-hoy.png';
import plan from '../../assets/capturas/watch-2-plan.png';

interface Props { lang: Idioma; }
const { lang } = Astro.props;
const c = reloj[lang];
const alt = lang === 'es'
  ? ['La sesión de hoy en el Apple Watch', 'El plan de la semana en el Apple Watch']
  : ["Today's session on Apple Watch", "The week's plan on Apple Watch"];
---
<section class="seccion">
  <div class="envoltorio interior">
    <div class="relojes revelar">
      <InkSplash variante={1} opacidad={0.08} tam="min(560px, 92%)" estilo="top:50%;left:50%;translate:-50% -50%" />
      {[hoy, plan].map((src, i) => (
        <Image class={`reloj r${i + 1}`} src={src} alt={alt[i]} width={200} densities={[1, 2]} loading="lazy" />
      ))}
    </div>

    <div class="texto">
      <Rotulo clave="reloj" lang={lang} titulo={c.titulo} medida={12} />
      {c.cuerpo.map((p) => <p class="parrafo revelar">{p}</p>)}
    </div>
  </div>
</section>

<style>
  .seccion {
    padding: clamp(60px, 8vw, 110px) 0;
    content-visibility: auto;
    contain-intrinsic-size: auto 560px;
  }
  .interior {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .parrafo { font-size: clamp(17px, 1.5vw, 19px); color: var(--ink-soft); max-width: 44ch; }
  .parrafo + .parrafo { margin-top: 14px; }

  /* Los dos relojes, solapados y con un grado de giro: puestos en fila y
     rectos parecian dos capturas de prensa, no un producto. */
  .relojes {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    isolation: isolate;
    min-height: 340px;
  }
  .relojes > :global(.mancha) { z-index: -1; }
  .relojes :global(.reloj) {
    width: clamp(150px, 17vw, 200px);
    height: auto;
    border-radius: 30px;
    filter: drop-shadow(0 18px 34px rgba(0, 0, 0, 0.2));
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .relojes :global(.r1) { transform: rotate(-5deg) translateX(9%); z-index: 1; }
  .relojes :global(.r2) { transform: rotate(4deg) translateX(-9%) translateY(7%); }
  .relojes:hover :global(.r1) { transform: rotate(-6.5deg) translateX(4%) translateY(-2%); }
  .relojes:hover :global(.r2) { transform: rotate(5.5deg) translateX(-4%) translateY(9%); }

  @media (max-width: 860px) {
    .interior { grid-template-columns: 1fr; gap: 8px; }
    /* En una columna manda el texto: los relojes bajan debajo. */
    .relojes { order: 2; min-height: 300px; }
    .texto { order: 1; }
  }
</style>
