---
/* 03 · Lo que se recuerda. Antes era una rejilla bento; ahora es una plancha
 * editorial.
 *
 * El bento repartia cinco bloques en cinco tarjetas del mismo peso, y con eso
 * ninguno mandaba. Aqui hay jerarquia: un panel con la captura manda, tres
 * columnas separadas por filetes lo sostienen, y la cifra remata sola en una
 * banda propia. Fuera del panel no hay ni una caja: solo filetes y aire, que es
 * lo que hace que un bloque de texto parezca impreso y no una interfaz.
 */
import { getImage } from 'astro:assets';
import Rotulo from '../Rotulo.astro';
import { tarjetas } from '../../data/landing';
import { captura } from '../../data/capturas';
import type { Idioma } from '../../i18n/routes';

interface Props { lang: Idioma; }
const { lang } = Astro.props;
const t = tarjetas[lang];
const progreso = captura('progresoRecorte', lang);

// <picture> con media query: <Image> no sabe cambiar de fuente segun el tema,
// y en oscuro se colaba la captura clara.
// 420 px de ancho: la captura mide 1206x2464 (@3x de 402 pt), asi que a ese
// tamano se ve a escala natural. Estirada a todo el ancho del panel salia a
// dos veces y media su tamano logico y la interfaz parecia de juguete.
const fotoClara = await getImage({ src: progreso.claro, width: 420, densities: [1, 2], quality: 78 });
const fotoOscura = await getImage({ src: progreso.oscuro, width: 420, densities: [1, 2], quality: 78 });

const c = {
  es: {
    titulo: 'Lo que de verdad se recuerda',
    entradilla: 'No las medias ni los totales: la primera vez que aguantas diez minutos. Y nunca hay nadie más en esa pantalla.',
    cifraValor: '600',
    cifraUnidad: 'km',
    cifraPie: 'los kilómetros a los que casi cualquier media amortigua ya menos, y la app te avisa',
    privacidadTitulo: 'El interruptor viene encendido',
    privacidadTexto: 'Compartir una ruta es publicar dónde vives. Por eso esconder el inicio y el final no es una opción que haya que buscar: viene puesta de fábrica.',
  },
  en: {
    titulo: 'What you actually remember',
    entradilla: 'Not the averages or the totals: the first time you last ten minutes. And there is never anyone else on that screen.',
    cifraValor: '600',
    cifraUnidad: 'km',
    cifraPie: 'the kilometres at which almost any midsole already cushions less, and the app tells you',
    privacidadTitulo: 'The switch ships turned on',
    privacidadTexto: 'Sharing a route is publishing where you live. So hiding your start and finish is not an option you have to go looking for: it comes on by default.',
  },
}[lang];

const columnas = [
  { titulo: t[1].titulo, cuerpo: t[1].cuerpo[0] },
  { titulo: t[2].titulo, cuerpo: t[2].cuerpo[0] },
  { titulo: c.privacidadTitulo, cuerpo: c.privacidadTexto },
];
---
<section class="seccion">
  <div class="envoltorio">
    <Rotulo clave="memoria" lang={lang} titulo={c.titulo} entradilla={c.entradilla} />

    <!-- La plancha: el texto a la izquierda y la captura a tamano natural,
         cortada por el canto de abajo del panel. -->
    <figure class="plancha" data-escala>
      <figcaption>
        <h3>{t[0].titulo}</h3>
        <p>{t[0].cuerpo[0]}</p>
      </figcaption>
      <div class="foto">
        <picture>
          <source srcset={fotoOscura.srcSet.attribute || fotoOscura.src} media="(prefers-color-scheme: dark)" />
          <img
            src={fotoClara.src}
            srcset={fotoClara.srcSet.attribute || undefined}
            alt={progreso.alt}
            width={fotoClara.attributes.width}
            height={fotoClara.attributes.height}
            loading="lazy"
            decoding="async"
          />
        </picture>
      </div>
    </figure>

    <!-- Tres columnas, separadas por filete. Sin caja. -->
    <div class="columnas">
      {columnas.map((col, i) => (
        <article class="columna revelar" style={`--r:${i * 0.07}s`}>
          <h3>{col.titulo}</h3>
          <p>{col.cuerpo}</p>
        </article>
      ))}
    </div>

    <!-- La cifra, sola, con su filete: es un dato duro y se lee como tal. -->
    <div class="banda revelar">
      <p class="valor num">{c.cifraValor}<span class="unidad">{c.cifraUnidad}</span></p>
      <p class="pie">{c.cifraPie}</p>
    </div>
  </div>
</section>

<style>
  .seccion { padding: clamp(60px, 8vw, 110px) 0 clamp(40px, 5vw, 70px); }

  /* ── La plancha ─────────────────────────────────────────────────────────── */
  .plancha {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: clamp(26px, 4vw, 60px);
    margin: 0;
    overflow: hidden;
    border-radius: 28px;
    background: var(--fill-1);
    padding: clamp(30px, 4vw, 56px) clamp(24px, 4vw, 56px) 0;
    isolation: isolate;
  }

  figcaption { padding-bottom: clamp(34px, 4.4vw, 62px); }
  figcaption h3 {
    font-size: clamp(1.5rem, 2.6vw, 2.3rem);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.032em;
    max-width: 16ch;
    text-wrap: balance;
  }
  figcaption p {
    margin-top: 16px;
    font-size: clamp(15px, 1.4vw, 18px);
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 46ch;
  }

  /* La captura sale por el canto de abajo del panel. La ventana tiene alto
     propio y recorta: la pantalla completa mide 2464 px y, puesta entera, el
     panel pasaba de 850 px de alto y el titular se iba al sotano. */
  .foto {
    height: clamp(280px, 32vw, 430px);
    overflow: hidden;
    border-radius: 22px 22px 0 0;
    box-shadow: 0 22px 50px rgba(0, 0, 0, 0.16);
  }
  .foto picture { display: block; }
  .foto img {
    display: block;
    width: clamp(240px, 30vw, 400px);
    height: auto;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .plancha:hover .foto img { transform: translateY(-16px); }

  /* ── Las tres columnas ──────────────────────────────────────────────────── */
  .columnas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(22px, 3vw, 46px);
    margin-top: clamp(44px, 6vw, 78px);
  }
  .columna { padding-top: 20px; border-top: 1px solid var(--hairline); }
  .columna h3 {
    font-size: clamp(17px, 1.5vw, 20px);
    font-weight: 600;
    letter-spacing: -0.015em;
    max-width: 20ch;
  }
  .columna p { margin-top: 12px; font-size: 16px; line-height: 1.55; color: var(--ink-soft); }
  :global(.js) .columna.visible { transition-delay: var(--r); }

  /* ── La cifra ───────────────────────────────────────────────────────────── */
  .banda {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: end;
    gap: clamp(20px, 4vw, 56px);
    margin-top: clamp(48px, 6vw, 84px);
    padding-top: clamp(20px, 2.4vw, 30px);
    border-top: 1px solid var(--hairline);
  }
  .valor {
    font-size: clamp(3.6rem, 11vw, 9rem);
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 0.84;
  }
  .unidad { font-size: 0.26em; font-weight: 600; letter-spacing: -0.01em; margin-left: 0.12em; color: var(--ink-soft); }
  .pie {
    font-size: clamp(15px, 1.4vw, 18px);
    color: var(--ink-soft);
    max-width: 34ch;
    padding-bottom: 0.6em;
  }

  @media (max-width: 860px) {
    .plancha { grid-template-columns: 1fr; gap: 26px; }
    .foto { justify-self: center; }
    .columnas { grid-template-columns: 1fr; gap: 0; }
    .columna { padding-block: 20px; }
    .columna:last-child { border-bottom: 1px solid var(--hairline); }
    .banda { grid-template-columns: 1fr; align-items: start; gap: 14px; }
    .pie { padding-bottom: 0; }
  }
</style>
