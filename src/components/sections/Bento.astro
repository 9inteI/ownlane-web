---
/* Rejilla densa, sin celdas muertas.
 *
 * 4 columnas x 3 filas = 12 celdas, repartidas en:
 *   destacado 2x2 (4) + ancha 2x1 (2) + alta 1x2 (2) + cifra 1x2 (2)
 *   + ancha 2x1 (2)  =  12 de 12.
 *
 * Teselado, fila a fila:
 *   fila 1: destacado c1-2 | ancha  c3-4
 *   fila 2: destacado c1-2 | alta c3 | cifra c4
 *   fila 3: ancha2    c1-2 | alta c3 | cifra c4
 * Con la cifra a una sola fila quedaba la celda (c4, f3) vacia.
 * Con grid-auto-flow: dense, ademas, cualquier hueco que dejara un cambio
 * futuro lo rellena la siguiente pieza que quepa en vez de quedarse en blanco.
 */
import { getImage } from 'astro:assets';
import { tarjetas } from '../../data/landing';
import { captura } from '../../data/capturas';
import type { Idioma } from '../../i18n/routes';

interface Props { lang: Idioma; }
const { lang } = Astro.props;
const t = tarjetas[lang];
const progreso = captura('progreso', lang);

// <picture> con media query: <Image> no sabe cambiar de fuente segun el tema,
// y en oscuro se colaba la captura clara.
const fotoClara = await getImage({ src: progreso.claro, width: 520, densities: [1, 2], quality: 74 });
const fotoOscura = await getImage({ src: progreso.oscuro, width: 520, densities: [1, 2], quality: 74 });

const c = {
  es: {
    titulo: 'Lo que de verdad se recuerda',
    entradilla: 'No las medias ni los totales: la primera vez que aguantas diez minutos. Y nunca hay nadie más en esa pantalla.',
    cifraValor: '600',
    cifraPie: 'los kilómetros a los que casi cualquier media amortigua ya menos, y la app te avisa',
    privacidadTitulo: 'El interruptor viene encendido',
    privacidadTexto: 'Compartir una ruta es publicar dónde vives. Por eso esconder el inicio y el final no es una opción que haya que buscar: viene puesta de fábrica.',
  },
  en: {
    titulo: 'What you actually remember',
    entradilla: 'Not the averages or the totals: the first time you last ten minutes. And there is never anyone else on that screen.',
    cifraValor: '600',
    cifraPie: 'the kilometres at which almost any midsole already cushions less, and the app tells you',
    privacidadTitulo: 'The switch ships turned on',
    privacidadTexto: 'Sharing a route is publishing where you live. So hiding your start and finish is not an option you have to go looking for: it comes on by default.',
  },
}[lang];
---
<section class="seccion">
  <div class="envoltorio">
    <header class="cabecera">
      <h2>{c.titulo}</h2>
      <p class="entradilla">{c.entradilla}</p>
    </header>

    <div class="bento">
      <!-- 2x2: la pieza grande, con imagen -->
      <article class="celda destacado" data-escala>
        <div class="foto">
          <picture>
            <source srcset={fotoOscura.srcSet.attribute || fotoOscura.src} media="(prefers-color-scheme: dark)" />
            <img
              src={fotoClara.src}
              srcset={fotoClara.srcSet.attribute || undefined}
              alt={progreso.alt}
              width={fotoClara.attributes.width}
              height={fotoClara.attributes.height}
              loading="lazy"
              decoding="async"
            />
          </picture>
        </div>
        <div class="sobre">
          <h3>{t[0].titulo}</h3>
          <p>{t[0].cuerpo[0]}</p>
        </div>
      </article>

      <!-- 2x1 -->
      <article class="celda ancha">
        <h3>{c.privacidadTitulo}</h3>
        <p>{c.privacidadTexto}</p>
      </article>

      <!-- 1x2: columna alta -->
      <article class="celda alta">
        <h3>{t[1].titulo}</h3>
        <p>{t[1].cuerpo[0]}</p>
      </article>

      <!-- 1x1: la cifra -->
      <article class="celda cifra">
        <div class="num">{c.cifraValor}<span class="unidad">km</span></div>
        <p>{c.cifraPie}</p>
      </article>

      <!-- 2x1 -->
      <article class="celda ancha">
        <h3>{t[2].titulo}</h3>
        <p>{t[2].cuerpo[0]}</p>
      </article>
    </div>
  </div>
</section>

<style>
  .seccion { padding: 40px 0 24px; }
  .cabecera { max-width: 46rem; margin-bottom: 34px; }
  h2 { font-size: clamp(2rem, 3.6vw, 3.1rem); letter-spacing: -0.03em; }
  .cabecera .entradilla { margin-top: 14px; font-size: 19px; color: var(--ink-soft); }

  .bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: minmax(210px, auto);
    grid-auto-flow: dense;
    gap: 14px;
  }
  .destacado { grid-column: span 2; grid-row: span 2; }
  .ancha { grid-column: span 2; }
  .alta { grid-row: span 2; }
  .cifra { grid-column: span 1; grid-row: span 2; }

  .celda {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 10px;
    padding: 24px;
    border-radius: var(--radius-card);
    background: var(--card);
    border: 0.5px solid var(--card-border);
    box-shadow: var(--card-shadow);
  }
  .celda h3 { font-size: 19px; font-weight: 600; letter-spacing: -0.01em; }
  .celda p { font-size: 15px; color: var(--ink-soft); }

  /* Fisica de hover: la imagen crece dentro de su caja, la caja no se mueve. */
  .destacado { padding: 0; justify-content: flex-end; }
  .foto { position: absolute; inset: 0; overflow: hidden; }
  .foto :global(picture) { display: block; width: 100%; height: 100%; }
  .foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 8%;
    filter: contrast(1.04);
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .destacado:hover .foto :global(img) { transform: scale(1.05); }
  .sobre {
    position: relative;
    padding: 26px;
    color: var(--inverse-ink);
    background: linear-gradient(to top, var(--inverse-surface) 34%, transparent);
    padding-top: 90px;
  }
  .sobre h3 { color: inherit; }
  .sobre p { color: var(--inverse-ink-soft); }

  .cifra { justify-content: flex-start; }
  .num {
    font-size: clamp(2.6rem, 4vw, 3.6rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .unidad { font-size: 0.4em; font-weight: 600; margin-left: 0.14em; color: var(--ink-soft); }
  .cifra p { margin-top: auto; font-size: 14px; }

  @media (max-width: 900px) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .destacado, .ancha { grid-column: span 2; }
    .alta { grid-row: span 1; }
    .cifra { grid-column: span 2; }
  }
</style>
