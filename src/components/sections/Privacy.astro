---
/* 04 · Sin red social. Unico uso del teal en toda la web: en la app es el
 * color del descanso y de la privacidad.
 *
 * Los cuatro puntos ya no son pastillas sueltas: son una lista con filete,
 * numerada en monoespaciada, dentro de un panel con lavado teal. Leidos en
 * columna y con numero, se leen como una ficha tecnica —que es lo que son— y
 * no como cuatro etiquetas decorativas.
 */
import InkSplash from '../ink/InkSplash.astro';
import Rotulo from '../Rotulo.astro';
import { privacidad } from '../../data/landing';
import { ruta, type Idioma } from '../../i18n/routes';

interface Props { lang: Idioma; }
const { lang } = Astro.props;
const c = privacidad[lang];
---
<section class="privacidad">
  <InkSplash variante={2} opacidad={0.06} tam="min(520px, 66vw)" estilo="bottom:-190px;right:-180px" />
  <div class="envoltorio">
    <Rotulo clave="privacidad" lang={lang} titulo={c.titulo} medida={13} />

    <div class="interior">
      <div class="texto revelar">
        {c.cuerpo.map((p) => <p class="parrafo">{p}</p>)}
        <a class="enlace" href={ruta('privacidad', lang)}>
          {c.enlace}
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <ol class="puntos revelar">
        {c.puntos.map((p, i) => (
          <li>
            <span class="orden" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="que">{p}</span>
            <span class="tilde" aria-hidden="true">
              <svg viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .privacidad {
    position: relative;
    overflow: clip;
    padding: clamp(60px, 8vw, 110px) 0;
    content-visibility: auto;
    contain-intrinsic-size: auto 560px;
  }
  .interior {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    gap: clamp(30px, 5vw, 70px);
    align-items: start;
  }

  .parrafo { font-size: clamp(17px, 1.5vw, 19px); color: var(--ink-soft); max-width: 50ch; }
  .parrafo + .parrafo { margin-top: 16px; }

  .enlace {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 26px;
    font-weight: 600;
    color: var(--teal);
    text-decoration: none;
  }
  /* La flecha avanza; el texto se queda quieto y no baila. */
  .enlace span { transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1); }
  .enlace:hover span { transform: translateX(4px); }
  .enlace:hover { text-decoration: underline; }

  .puntos {
    list-style: none;
    margin: 0;
    padding: clamp(8px, 1.4vw, 16px) clamp(18px, 2.4vw, 30px);
    border-radius: 24px;
    background: var(--teal-wash);
  }
  .puntos li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px;
    padding: clamp(15px, 1.8vw, 20px) 0;
  }
  .puntos li + li { border-top: 1px solid color-mix(in srgb, var(--teal) 22%, transparent); }
  .orden {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--teal);
    opacity: 0.75;
  }
  .que { font-size: clamp(16px, 1.5vw, 19px); font-weight: 600; letter-spacing: -0.015em; }
  .tilde { display: grid; place-items: center; width: 20px; height: 20px; color: var(--teal); }
  .tilde svg { width: 100%; height: 100%; }

  @media (max-width: 860px) {
    .interior { grid-template-columns: 1fr; gap: 30px; }
  }
</style>
