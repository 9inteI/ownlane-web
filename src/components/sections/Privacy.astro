---
import InkSplash from '../ink/InkSplash.astro';
import { privacidad } from '../../data/landing';
import { ruta, type Idioma } from '../../i18n/routes';

interface Props { lang: Idioma; }
const { lang } = Astro.props;
const c = privacidad[lang];
---
<section class="privacidad">
  <InkSplash variante={2} opacidad={0.07} tam="min(460px, 62vw)" estilo="bottom:-160px;right:-160px" />
  <div class="envoltorio interior">
    <div class="texto revelar">
      <p class="eyebrow teal">{c.eyebrow}</p>
      <h2>{c.titulo}</h2>
      {c.cuerpo.map((p) => <p class="parrafo">{p}</p>)}
      <a class="enlace" href={ruta('privacidad', lang)}>{c.enlace} →</a>
    </div>
    <ul class="puntos revelar">
      {c.puntos.map((p) => (
        <li>
          <span class="marca" aria-hidden="true">
            <svg viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          {p}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Unico uso del teal en toda la web: en la app es descanso y privacidad. */
  .privacidad {
    position: relative;
    overflow: clip;
    padding: 60px 0;
    content-visibility: auto;
    contain-intrinsic-size: auto 480px;
  }
  .interior {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: 48px;
    align-items: center;
  }
  .teal { color: var(--teal); }
  h2 { margin: 12px 0 18px; max-width: 16ch; }
  .parrafo { font-size: 18px; color: var(--ink-soft); max-width: 52ch; }
  .parrafo + .parrafo { margin-top: 14px; }
  .enlace {
    display: inline-block;
    margin-top: 20px;
    font-weight: 600;
    color: var(--teal);
    text-decoration: none;
  }
  .enlace:hover { text-decoration: underline; }

  .puntos { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .puntos li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 15px 18px;
    border-radius: 14px;
    background: var(--teal-wash);
    font-weight: 600;
    font-size: 16px;
  }
  .marca { display: grid; place-items: center; width: 20px; height: 20px; color: var(--teal); flex: none; }
  .marca svg { width: 100%; height: 100%; }

  @media (max-width: 860px) {
    .interior { grid-template-columns: 1fr; gap: 32px; }
  }
</style>
