---
/* Iconos propios, dibujados a mano en SVG de 24x24 con currentColor.
 * La app usa SF Symbols, que no se pueden servir en web; importar una libreria
 * entera por nueve formas seria peor negocio que dibujarlas. */
interface Props { nombre: string; tam?: number; }
const { nombre, tam = 22 } = Astro.props;

const trazos: Record<string, string> = {
  fuerza: 'M4 12h2m12 0h2M6 9v6M18 9v6M8 7v10M16 7v10M8 12h8',
  movilidad: 'M12 4a1.6 1.6 0 1 0 0 .01M9 20l1.6-5L9 12l-3 1.5M15 20l-1.4-5.5M10.6 15l4-1.2 1.4-4.3-3.6-1.2-3.4 2',
  carrera: 'M5 21V4M5 5h9l-1.4 3.2L14 11H5M14 11h5v6h-5z',
  lectura: 'M4 5h16v11H9l-5 4z M8 9h8M8 12.5h5',
  informe: 'M4 19h16M6 19V9m4 10V5m4 14v-7m4 7V8',
  rutas: 'M6 20c0-5 4-4 4-8s-4-3-4-8M18 4c0 5-4 4-4 8s4 3 4 8',
  marcas: 'M8 4h8v5a4 4 0 0 1-8 0zM8 5H5v2a3 3 0 0 0 3 3M16 5h3v2a3 3 0 0 1-3 3M10 17h4M9 21h6M12 13v4',
  pulso: 'M3 12h3l2-6 3 12 3-9 2 3h5',
  meta: 'M5 21V4m0 1h14l-3 4 3 4H5',
};
const d = trazos[nombre] ?? trazos.meta;
---
<span class="insignia" style={`--tam:${tam}px`} aria-hidden="true">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    {d.split(' M').map((p, i) => <path d={i === 0 ? p : `M${p}`} />)}
  </svg>
</span>

<style>
  /* IconBadge de la app: simbolo dentro de un circulo con wash de tinta. */
  .insignia {
    display: grid;
    place-items: center;
    width: calc(var(--tam) * 1.85);
    height: calc(var(--tam) * 1.85);
    border-radius: 50%;
    background: var(--tint-wash);
    color: var(--ink);
    flex: none;
  }
  svg { width: var(--tam); height: var(--tam); }
</style>
